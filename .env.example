# Server
PORT=53682
FRONTEND_URL=http://localhost:53682

# Firebase - choose one auth mode
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Mode 1: Service Account
# Docker recommended: use inline JSON, or mount serviceAccount.json and set the container path below.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase_service_account

# Mode 2: Database Secret
# FIREBASE_DATABASE_SECRET=your_database_secret

# Optional: encrypt clientSecret fields in Firebase
# ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional: runner build metadata displayed in the UI
# _DOTENVRTDB_RUNNER_COMMIT_SHORT_ID=abcdef0
# _DOTENVRTDB_RUNNER_COMMIT_AT=2026-04-30T12:00:00Z

# CORS for separate frontend hosts
ALLOWED_ORIGINS=http://localhost:53682,http://localhost:3000
